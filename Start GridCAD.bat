@echo off
setlocal DisableDelayedExpansion
rem Run the source already shipped with GridCAD. No policy changes or EXE tricks.
set "GRIDCAD_SOURCE_ROOT=%~dp0"
if not exist "%~dp0gridcad_desktop.py" (
  echo Keep this launcher inside the complete extracted GridCAD folder.
  pause
  exit /b 1
)
if not exist "%~dp0tools\source_launcher.py" (
  echo The launcher helper is missing. Extract the complete GridCAD source bundle again.
  pause
  exit /b 1
)
echo GridCAD
echo Checking for verified Python...
rem Keep PowerShell 7 or user-installed modules out of this Windows PowerShell child.
rem SETLOCAL makes this process-local; no registry or security policy is changed.
set "PSModulePath=%SystemRoot%\System32\WindowsPowerShell\v1.0\Modules"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command ^
 "$ErrorActionPreference='Stop';" ^
 "function Test-OfficialPython($p) { if (-not (Test-Path -LiteralPath $p -PathType Leaf)) { return $false }; $s=Get-AuthenticodeSignature -LiteralPath $p; if ($s.Status -ne 'Valid' -or $s.SignerCertificate.Subject -notmatch '(^|,\s*)(CN|O)=Python Software Foundation(,|$)') { return $false }; $v=(Get-Item -LiteralPath $p).VersionInfo.ProductVersion; if ($v -notmatch '^3\.13\.' -or [version]($v -replace '[^0-9.].*$','') -lt [version]'3.13.16') { return $false }; & $p -I -c 'import sys,tkinter,ssl; assert sys.version_info[:2]==(3,13) and sys.maxsize>4294967296; r=tkinter.Tk(); r.withdraw(); r.update_idletasks(); r.destroy()' 2>$null; return $LASTEXITCODE -eq 0 };" ^
 "try { $held=$false; $mutex=New-Object System.Threading.Mutex($false,('Local\GridCAD-Python-'+[Security.Principal.WindowsIdentity]::GetCurrent().User.Value)); try { $held=$mutex.WaitOne(0) } catch [Threading.AbandonedMutexException] { $held=$true }; if (-not $held) { throw 'Another GridCAD setup is running. Let it finish, then try again.' }; $local=[Environment]::GetFolderPath('LocalApplicationData'); $owned=Join-Path $local 'GridCAD\Python313'; $paths=@((Join-Path $owned 'python.exe'),(Join-Path $local 'Programs\Python\Python313\python.exe')); foreach ($key in @('HKCU:\Software\Python\PythonCore\3.13\InstallPath','HKLM:\Software\Python\PythonCore\3.13\InstallPath')) { if (Test-Path -LiteralPath $key) { $paths+=Join-Path ((Get-Item -LiteralPath $key).GetValue('')) 'python.exe' } }; $python=$null; $setupApproved=$false; foreach ($p in $paths) { if (Test-OfficialPython $p) { $python=$p; break } };" ^
 "if (-not $python) { Write-Host 'GridCAD needs official 64-bit Python 3.13 with Tk. No suitable verified installation was found.'; Write-Host 'Setup can download Python 3.13.16 from python.org and install it for your account, then install Pillow for GridCAD.'; Write-Host 'No administrator rights, PATH changes, file associations or security changes are requested.'; $answer=Read-Host 'Install these free components now? Type Y to continue, or press Enter to cancel'; if ($answer -cne 'Y' -and $answer -cne 'y') { Write-Host 'Setup canceled. Nothing was installed.'; exit 2 }; $setupApproved=$true;" ^
 " $record=Join-Path $local 'GridCAD\python-installer.sha256'; $repair=Test-Path -LiteralPath $owned; if ($repair -and (-not (Test-Path -LiteralPath $record) -or (Get-Content -LiteralPath $record -Raw).Trim() -ne 'fb4f9f5d438b2396da0086dc70b935c530cb578e37adc6d354f7ad2037fee83b')) { throw 'An existing Python folder could not be verified as a GridCAD setup. Nothing was overwritten. Use Settings - Apps to repair that Python installation, then try again.' }; $download=Join-Path ([IO.Path]::GetTempPath()) ('GridCAD-python-'+[Guid]::NewGuid().ToString('N')+'.exe'); try { Write-Host 'Downloading the official Python installer...'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -UseBasicParsing -TimeoutSec 120 -Uri 'https://www.python.org/ftp/python/3.13.16/python-3.13.16-amd64.exe' -OutFile $download; if ((Get-FileHash -LiteralPath $download -Algorithm SHA256).Hash -ne 'FB4F9F5D438B2396DA0086DC70B935C530CB578E37ADC6D354F7AD2037FEE83B') { throw 'The Python download did not match its published checksum. It was not run.' }; $sig=Get-AuthenticodeSignature -LiteralPath $download; if ($sig.Status -ne 'Valid' -or $sig.SignerCertificate.Subject -notmatch '(^|,\s*)(CN|O)=Python Software Foundation(,|$)') { throw 'The Python installer publisher could not be verified. It was not run.' }; New-Item -ItemType Directory -Force -Path (Split-Path $record) | Out-Null; Set-Content -LiteralPath $record -Value 'fb4f9f5d438b2396da0086dc70b935c530cb578e37adc6d354f7ad2037fee83b'; Write-Host 'Installing or repairing verified Python for your account...'; $quote=[char]34; $arguments='/passive InstallAllUsers=0 TargetDir='+$quote+$owned+$quote+' PrependPath=0 AppendPath=0 AssociateFiles=0 Shortcuts=0 Include_launcher=0 InstallLauncherAllUsers=0 Include_pip=1 Include_tcltk=1 Include_test=0 Include_doc=0'; if ($repair) { $arguments='/repair '+$arguments }; $installed=Start-Process -FilePath $download -ArgumentList $arguments -Wait -PassThru; if ($installed.ExitCode -ne 0) { throw ('Python setup did not finish successfully (code '+$installed.ExitCode+'). Restart Windows if requested, then try again.') }; } finally { Remove-Item -LiteralPath $download -Force -ErrorAction SilentlyContinue }; $python=Join-Path $owned 'python.exe'; if (-not (Test-OfficialPython $python)) { throw 'Python setup finished, but the required verified Python and Tk could not be loaded.' } };" ^
 "$mutex.ReleaseMutex(); $held=$false; Write-Host 'Python verified.'; $helper=Join-Path $env:GRIDCAD_SOURCE_ROOT 'tools\source_launcher.py'; if ($setupApproved) { & $python -I $helper --setup-approved } else { & $python -I $helper }; exit $LASTEXITCODE } catch { Write-Host ('GridCAD could not start: '+$_.Exception.Message); Write-Host 'Check your connection for download errors. If Windows blocks a component, keep protections enabled and report its name.'; exit 1 } finally { if ($held) { $mutex.ReleaseMutex() }; if ($mutex) { $mutex.Dispose() } }"
set "GRIDCAD_RESULT=%ERRORLEVEL%"
if not "%GRIDCAD_RESULT%"=="0" pause
exit /b %GRIDCAD_RESULT%
